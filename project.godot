; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="RPG LBA - Las Cenizas de Lythara"
config/description="Action RPG isométrico de fantasía oscura caribeña. Cuba ficticia, 1953. Campaña: El Eco de Valdeluz."
config/tags=PackedStringArray("3d", "arpg")
run/main_scene="res://scenes/arpg/menu/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"

[autoload]

Network="*res://scripts/autoload/network.gd"
ItemDatabase="*res://scripts/autoload/item_database.gd"
RpgDB="*res://scripts/arpg/autoloads/rpg_db.gd"
SaveSystem="*res://scripts/arpg/autoloads/save_system.gd"
QuestSystem="*res://scripts/arpg/autoloads/quest_system.gd"
GraphicsSettings="*res://scripts/arpg/autoloads/graphics_settings.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[filesystem]

import/blender/enabled=false

[global_group]

Players="A group containing all of the player nodes"
arpg_enemies="Enemigos ARPG visibles en el minimapa (blips rojos)"
arpg_pickups="Objetos recogibles ARPG visibles en el minimapa (blips dorados)"
arpg_npcs="NPCs ARPG visibles en el minimapa (blips verdes)"

