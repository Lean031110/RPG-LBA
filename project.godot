[layer_names]

3d_physics/layer_1="player"
3d_physics/layer_2="world"
3d_physics/layer_3="arpg_player"
3d_physics/layer_4="arpg_world"
3d_physics/layer_5="arpg_enemy"
3d_physics/layer_6="arpg_pickup"
3d_physics/layer_7="arpg_hitbox_player"
3d_physics/layer_8="arpg_hitbox_enemy"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=0
; Fase 2: requerido por el preset Android (arm64). Sin ETC2/ASTC, la exportación
; Android falla con "Cannot export for universal or arm64...". No afecta al escritorio.
textures/vram_compression/import_etc2_astc=true
