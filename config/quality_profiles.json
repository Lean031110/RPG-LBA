{
  "schema_version": 1,
  "renderer": "gl_compatibility",
  "profiles": {
    "low": {
      "target_fps": 30,
      "render_scale_initial": 0.70,
      "dynamic_shadows": false,
      "max_visible_particles": 40,
      "vegetation_density": 0.45,
      "view_distance_multiplier": 0.65,
      "post_processing": false,
      "note": "Valores de arranque sujetos a medición en hardware real. No declarar 30 FPS sin benchmark sostenido."
    },
    "medium": {
      "target_fps": 30,
      "render_scale_initial": 0.85,
      "dynamic_shadows": "one_directional_light_if_benchmark_passes",
      "max_visible_particles": 80,
      "vegetation_density": 0.75,
      "view_distance_multiplier": 0.85,
      "post_processing": "minimal"
    },
    "high": {
      "target_fps": 60,
      "render_scale_initial": 1.0,
      "dynamic_shadows": "limited_if_benchmark_passes",
      "max_visible_particles": 140,
      "vegetation_density": 1.0,
      "view_distance_multiplier": 1.0,
      "post_processing": "selective"
    },
    "adaptive": {
      "initial_profile": "low",
      "policy": "adjust_on_sustained_frame_time_and_thermal_signals_with_hysteresis",
      "note": "No existe garantía de acceso a temperatura en todos los dispositivos. Evitar cambios bruscos de calidad."
    }
  }
}
