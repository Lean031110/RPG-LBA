# Godot 4+ specific ignores
.godot/
*.translation

# Godot-specific ignores
.import/
export.cfg
# Fase 2: export_presets.cfg SE versiona (preset Android Debug sin credenciales;
# android-debug.yml lo busca en el repo). Las credenciales NUNCA se versionan:
export_credentials.cfg
*.keystore
# Fase 3B — excepción: la autofirma debug del proyecto SÍ se versiona.
# NO es un secreto: es una clave autofirmada de desarrollo con credenciales
# públicas documentadas (build/android/README.md), comparable al keystore
# debug universal de Android. Nunca usar para firmar una release pública.
!build/android/rpglba-debug.keystore

# Build ignores
builds/
bin/
releases/
# gdUnit4: el bin/ del addon es su runtime de pruebas, no un artefacto de build.
# Sin esta excepcion, git ignora addons/gdUnit4/bin y la CI no puede correr tests.
!addons/gdUnit4/bin/

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# System specific ignores
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
*.tmp

# CI / test artifacts (import logs, multiplayer smoke logs, build info)
artifacts/

# Editor
.vscode/
*.code-workspace

# GdUnit4 local reports (publicados como artefactos por CI, no versionados)
reports/
